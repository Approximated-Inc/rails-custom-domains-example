# Leave blank for the process-local demo. Set a real key to use Approximated.
# Server-only. Never expose this value to rendered HTML or JavaScript.
APPROXIMATED_API_KEY=

# Optional override. Set to mock to keep using the local demo with a key present.
APPROXIMATED_MODE=

# Public HTTPS origin hostname that Approximated forwards to.
APP_ORIGIN_HOST=origin.example.com

# Local control surface and development-only fixture login.
CONTROL_HOST=localhost
DEMO_LOGIN_PASSWORD=demo-only
